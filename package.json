{
  "name": "terrania-origins",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/write-runtime-config.mjs && ng serve --host 127.0.0.1 --port 5173",
    "typecheck": "node scripts/write-runtime-config.mjs && ngc -p tsconfig.json --noEmit",
    "build": "node scripts/write-runtime-config.mjs && ng build && node scripts/emit-route-shells.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "^7.1.10",
    "wrangler": "4.156.0",
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.56.1"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "phaser": "3.90.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  }
}
